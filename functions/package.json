{
  "name": "yalla-functions",
  "private": true,
  "description": "Cloud Functions for Yalla: the daily Web Push reminder.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.dev.json",
    "test": "vitest run",
    "serve": "npm run build && firebase emulators:start --only functions",
    "logs": "firebase functions:log --only remind"
  },
  "dependencies": {
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
